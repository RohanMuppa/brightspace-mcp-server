# Your Brightspace credentials (required)
D2L_USERNAME=your_username
D2L_PASSWORD=your_password

# Your institution's Brightspace URL (required)
# Examples: https://purdue.brightspace.com, https://myuni.brightspace.com
D2L_BASE_URL=https://purdue.brightspace.com

# Optional: an authenticator setup key (or a full otpauth:// link), so a
# Microsoft Entra verification-code challenge is answered here instead of on
# your phone. Off unless set. This is for CI and containers that have no OS
# credential store; on a normal machine run `setup` instead, which keeps the
# key in the OS keychain. WEAKER than the keychain: anything that can read this
# process's environment gets your second factor, so it is never the default.
# D2L_TOTP_SECRET=your_authenticator_setup_key

D2L_SESSION_DIR=~/.d2l-session
D2L_TOKEN_TTL=3600

# Course filtering (optional) — applies to all multi-course tools
# D2L_INCLUDE_COURSES=123456,789012       # Whitelist: only show these course IDs (comma-separated)
# D2L_EXCLUDE_COURSES=111111,222222       # Blacklist: hide these course IDs (comma-separated)
# D2L_ACTIVE_ONLY=true                    # Only show active courses (default: true; accepts true/false, 1/0, yes/no)
# D2L_CURRENT_ONLY=false                  # Only show courses in their current enrollment window, like Brightspace's "Current Courses" widget (default: false; accepts true/false, 1/0, yes/no)

# Sign-in behavior (optional)
# D2L_HEADLESS=true                       # false shows the browser during sign-in, for MFA methods that need a click
# D2L_REMEMBER_MFA=false                  # true ticks Microsoft's "Don't ask again" box (not for shared computers)
# D2L_PASSWORDLESS=false                  # true uses Microsoft Entra passwordless phone approval; no password is saved
# D2L_DUO_PASSCODE=1                      # On Duo, type a passcode instead of waiting for a push
# D2L_CAMPUS=SUNY Poly                    # Campus on a shared multi-campus instance (SUNY)

# Skip the browser entirely (optional; see LLMs.md "Browser-free sign-in")
# D2L_ACCESS_TOKEN=your_bearer_token
# D2L_SESSION_COOKIE=d2lSessionVal=...; d2lSecureSessionVal=...

# Maintenance (optional)
# D2L_NO_UPDATE_CHECK=1                   # Turn off the new-version notice
# D2L_DEV_MODE=true                       # Write a local, content-free activity log (see docs/dev-mode.md)
